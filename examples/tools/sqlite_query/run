#!/usr/bin/env python3
"""noclaw external tool: arguments arrive as JSON on stdin, the result goes
to stdout, and a nonzero exit status tells the model the call failed."""
import json
import os
import sqlite3
import sys

args = json.load(sys.stdin)
workspace = os.path.realpath(os.environ["NOCLAW_WORKSPACE"])
path = os.path.realpath(os.path.join(workspace, args["database"]))
if not path.startswith(workspace + os.sep):
    sys.exit("error: database must be inside the workspace")

try:
    # mode=ro: the database is opened read-only, so the model cannot modify it.
    con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    cur = con.execute(args["sql"])
    rows = cur.fetchmany(int(args.get("max_rows", 100)))
except sqlite3.Error as e:
    sys.exit(f"error: {e}")

print("\t".join(d[0] for d in cur.description or []))
for row in rows:
    print("\t".join("" if v is None else str(v) for v in row))
if cur.fetchone() is not None:
    print("[more rows not shown; raise max_rows]")
